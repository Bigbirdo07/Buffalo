="Y"><LastName>De Ridder</LastName><ForeName>Willem</ForeName><Initials>W</Initials><AffiliationInfo><Affiliation>Translational Neurosciences, Faculty of Medicine and Health Sciences, University of Antwerp, Antwerp, Belgium.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Laboratory of Neuromuscular Pathology, Institute Born-Bunge, University of Antwerp, Antwerp, Belgium.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Neuromuscular Reference Centre, Department of Neurology, Antwerp University Hospital, Antwerp, Belgium.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>De Jonghe</LastName><ForeName>Peter</ForeName><Initials>P</Initials><AffiliationInfo><Affiliation>Neuromuscular Reference Centre, Department of Neurology, Antwerp University Hospital, Antwerp, Belgium.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Baets</LastName><ForeName>Jonathan</ForeName><Initials>J</Initials><AffiliationInfo><Affiliation>Translational Neurosciences, Faculty of Medicine and Health Sciences, University of Antwerp, Antwerp, Belgium.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Laboratory of Neuromuscular Pathology, Institute Born-Bunge, University of Antwerp, Antwerp, Belgium.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Neuromuscular Reference Centre, Department of Neurology, Antwerp University Hospital, Antwerp, Belgium.</Affiliation></AffiliationInfo></Author></AuthorList><Language>eng</Language><GrantList CompleteYN="Y"><Grant><GrantID>739510</GrantID><Agency>European Reference Network for Rare Neurological Diseases</Agency><Country/></Grant><Grant><GrantID>870177</GrantID><Agency>European Reference Network for Rare Neuromuscular Diseases</Agency><Country/></Grant><Grant><Agency>Goldwasser-Emsens fellowship</Agency><Country/></Grant><Grant><Agency>Solve-RD project from the Horizon 2020 Research and Innovation Programme</Agency><Country/></Grant><Grant><GrantID>11F0921N</GrantID