le="western"><surname>Kanack</surname><given-names initials="AJ">Adam J.</given-names></name><xref ref-type="aff" rid="aff1"/><xref ref-type="author-notes" rid="FN1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Newsom</surname><given-names initials="OJ">Oliver J.</given-names></name><xref ref-type="aff" rid="aff1"/><xref ref-type="author-notes" rid="FN1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Scaglione</surname><given-names initials="KM">Kenneth Matthew</given-names></name><xref ref-type="aff" rid="aff1"/><xref ref-type="corresp" rid="cor1"><sup>2</sup></xref></contrib><aff id="aff1">From the Department of Biochemistry and the Neuroscience Research Center, Medical College of Wisconsin, Milwaukee, Wisconsin 53226</aff></contrib-group><author-notes><corresp id="cor1"><label>2</label> To whom correspondence should be addressed:
