<?xml version="1.0" encoding="UTF-8"?><article xml:lang="en" article-type="research-article"><front><journal-meta><journal-id journal-id-type="pmc-domain-id">48</journal-id><journal-id journal-id-type="pmc-domain">bmcneul</journal-id><journal-title-group><journal-title>BMC Neurology</journal-title><abbrev-journal-title>BMC Neurol</abbrev-journal-title></journal-title-group><publisher><publisher-name>BMC</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC13123184</article-id><article-id pub-id-type="pmcaid">13123184</article-id><article-id pub-id-type="pmcaiid">13123184</article-id><article-id pub-id-type="pmid">41851873</article-id><article-id pub-id-type="doi">10.1186/s12883-026-04815-7</article-id><title-group><article-title>A novel <italic>STUB1</italic> p.(Gln118*) nonsense variant in compound heterozygosity causes autosomal recessive spinocerebellar ataxia type 16 in a Chinese patient</article-title></title-group><contrib-group content-type="author"><contrib><name name-style="western"><surname>Zheng</surname><given-names initials="KM">Kun-Mu</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="author-notes" rid="_eqcntrb93pmc__">#</xref></contrib><contrib><name name-style="western"><surname>Tang</surname><given-names initials="MK">Ming-Kun</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff4">4</xref><xref ref-type="author-notes" rid="_eqcntrb93pmc__">#</xref></contrib><contrib><name name-style="western"><surname>Li</surname><given-names initials="JP">Jian-Peng</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="author-notes" rid="_eqcntrb93pmc__">#</xref></contrib><contrib><name name-style="western"><surname>Liu</surname><given-names initials="Q">Qi</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Bi</surname><given-names initials="M">Min</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Wan</surname><given-names initials="HJ">Hui-Juan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Jiang</surname><given-names initials="HW">Hui-Wen</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib><name name-style="western"><surname>Yu</surname><given-names initials="ZW">Zi-Wen</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Wang</surname><given-names initials="J">Jing</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Xu</surname><given-names initials="CC">Chu-Chuan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Wu</surname><given-names initials="JX">Jing-Xun</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff6">6</xref><xref ref-type="author-notes" rid="_fncrsp93pmc__">✉</xref></contrib><contrib><name name-style="western"><surname>Xiao</surname><given-names initials="NA">Nai-An</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff7">7</xref><xref ref-type="author-notes" rid="_fncrsp93pmc__">✉</xref></contrib><contrib><name name-style="western"><surname>Jiang</surname><given-names initials="B">Bin</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="author-notes" rid="_fncrsp93pmc__">✉</xref></contrib></contrib-group><aff id="Aff1"><label>1</label>The School of Clinical Medicine, Fujian Medical University, Fuzhou, China </aff><aff id="Aff2"><label>2</label>Department of Neurology, Department of Neuroscience, School of Medicine, The First Affiliated Hospital of Xiamen University, Xiamen University, Xiamen, China </aff><aff id="Aff3"><label>3</label>Xiamen Medical Quality Control Center for Neurology, Xiamen, China </aff><aff id="Aff4"><label>4</label>Health Management Center, School of Medicine, The First Affiliated Hospital of Xiamen University, Xiamen University, Xiamen, China </aff><aff id="Aff5"><label>5</label>Department of Neurology, Longyan People Hospital of Fujian, Longyan, China </aff><aff id="Aff6"><label>6</label>Department of Medical Oncology, School of Medicine, The First Affiliated Hospital of Xiamen University, Xiamen University, Xiamen, China </aff><aff id="Aff7"><label>7</label>Department of Neurology, The Third Hospital of Xiamen, Xiamen, China </aff><author-notes><fn id="_fncrsp93pmc__"><label>✉</label><p>Corresponding author.</p></fn><fn id="_eqcntrb93pmc__"><label>#</label><p>Contributed equally.</p></fn></author-notes><pub-date><day>19</day><month>3</month><year>2026</year></pub-date><volume>26</volume><fpage>283</fpage><page-range>283</page-range><pub-history><event event-type="pmc-release"><date><day>29</day><month>4</month><year>2026</year></date></event></pub-history><permissions><copyright-statement>© The Author(s) 2026</copyright-statement><license><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article’s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article’s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/" ext-link-type="uri">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="12883_2026_Article_4815.pdf" content-type="pmc-pdf"><?cloudpmc-path 5984/13123184/9b106c9a4534/12883_2026_Article_4815.pdf?><?cloudpmc-bucket app?><?size 2485044?></self-uri><abstract id="Abs1" abstract-type="structured"><title>Abstract</title><sec id="sec1" disp-level="2"><title>Background</title><p id="Par1">Spinocerebellar ataxias comprise a group of neurodegenerative disorders characterized by progressive cerebellar ataxia with clinical and genetic heterogeneity. Autosomal recessive spinocerebellar ataxia type 16 (SCAR16) is characterized by cerebellar ataxia accompanied by pyramidal tract damage, cognitive decline, hypogonadism, and extrapyramidal symptoms. SCAR16 is caused by mutations in the STIP1 homology and U-box containing protein 1 (<italic>STUB1</italic>) gene.</p></sec><sec id="sec2" disp-level="2"><title>Methods</title><p id="Par2">The whole-exome sequencing combined with long-range flanking polymerase chain reaction (PCR) were performed in a Chinese SCAR16 patient. Furthermore, we used quantitative real-time PCR and western blot analysis to investigate the function of variant in <italic>STUB1</italic> in cultured cells.</p></sec><sec id="sec3" disp-level="2"><title>Results</title><p id="Par3">We identified a compound heterozygote in <italic>STUB1</italic> containing a novel nonsense variant, <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.4" ext-link-type="uri">NM_005861.4</ext-link>:c.352 C &gt; T, p.(Gln118*), and a pathogenic missense variant, <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.4" ext-link-type="uri">NM_005861.4</ext-link>:c.433 A &gt; C, p.(Lys145Gln), in a Chinese SCAR16 patient. The age at onset was 27 years old with clinical characteristics of cerebellar ataxia and increased tendon reflex. We found that <italic>STUB1</italic> p.(Gln118*) variant generated truncated proteins of the C-terminus of Hsc70-interacting protein and caused the loss function of ubiquitin ligase activity.</p></sec><sec id="sec4" disp-level="2"><title>Conclusions</title><p id="Par4">Our results confirmed the pathogenicity of the <italic>STUB1</italic> p.(Gln118*) variant, expanding the spectrum of causative variants associated with SCAR16.</p></sec><sec id="sec5" disp-level="2"><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s12883-026-04815-7.</p></sec><sec id="kwd-group1" xml:lang="en" sec-type="kwd-group" disp-level="2"><p><bold>Keywords:</bold> Autosomal recessive spinocerebellar ataxia-16, <italic>STUB1</italic>, Novel mutation, Chinese patient</p></sec></abstract><custom-meta-group><custom-meta><meta-name>status</meta-name><meta-value>released</meta-value></custom-meta><custom-meta><meta-name>display-pdf</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>is-olf</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-manuscript</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-preprint</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-journal-matter</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-scanned</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-retracted</meta-name><meta-value>no</meta-value></custom-meta></custom-meta-group></article-meta><notes notes-type="article-notes"><sec id="historyarticle-meta1" sec-type="history" disp-level="2"><p>Received 2024 Nov 21; Accepted 2026 Mar 10; Collection date 2026.</p></sec></notes></front><body><sec id="Sec1" disp-level="1"><title>Background</title><p id="Par19">Spinocerebellar ataxias (SCAs) are a group of neurodegenerative disorders characterized by progressive cerebellar ataxia with clinical and genetic heterogeneity. The global prevalence of SCA is estimated to be 1 to 5 cases per 100,000 persons, and more than 40 types of SCA have been genetically determined [<xref rid="CR1" ref-type="bibr">1</xref>]. Autosomal recessive SCA type 16 (SCAR16) is characterized by cerebellar ataxia and a broad spectrum of symptoms, including pyramidal tract signs, cognitive decline, hypogonadism, and head and hand tremors, likely due to cerebellar and spinal cord atrophy [<xref rid="CR2" ref-type="bibr">2</xref>].</p><p id="Par20">The STIP1 homology and U-box containing protein 1 (<italic>STUB1</italic>) gene was first identified as a causative gene for SCAR16 in 2013 [<xref rid="CR3" ref-type="bibr">3</xref>]. <italic>STUB1</italic> encodes the C-terminus of Hsc70-interacting protein (CHIP), which is expressed in most tissues, especially in tissues with high metabolic activity, such as the brain and skeletal muscles. Moreover, the structure of CHIP comprises three functional domains: an N-terminal three-tetratricopeptide repeat (TPR) domain, a coiled-coil domain, and a carboxyl-terminal U-box domain [<xref rid="CR4" ref-type="bibr">4</xref>]. The TPR domain mediates interactions between CHIP and molecular chaperones, whereas the U-box domain functions as an E3 ubiquitin ligase that regulates ubiquitination-mediated degradation [<xref rid="CR5" ref-type="bibr">5</xref>]. CHIP plays a critical neuroprotective role by ubiquitinating misfolded proteins and facilitating the removal of accumulated abnormal proteins [<xref rid="CR6" ref-type="bibr">6</xref>].</p><p id="Par21">To date, over 50 different homozygous or heterozygous variants within <italic>STUB1</italic> have been reported to be associated with SCAR16 and autosomal dominant SCA type 48 (SCA48), according to the Human Gene Mutation Database (HGMD). The molecular mechanisms underlying <italic>STUB1</italic> mutations in the pathogenesis of SCAR16 have been reported in several previous studies. A patient carrying the nonsense mutation <italic>STUB1</italic> p.(Lys144*) did not show mature and steady-state CHIP. Additionally, a truncated form of CHIP was detected in fibroblasts, suggesting that the p.(Lys144*) mutation possibly disrupted the structure of CHIP [<xref rid="CR7" ref-type="bibr">7</xref>]. Furthermore, another mutation, <italic>STUB1</italic> p.(Asn65Ser), increased CHIP dimerization and inhibited the ability of CHIP to bind chaperones compared with wild-type (WT) CHIP [<xref rid="CR8" ref-type="bibr">8</xref>]. In addition, the <italic>STUB1</italic> missense mutation p.(Lys145Gln) has been found to impair the ubiquitin ligase activity of CHIP [<xref rid="CR9" ref-type="bibr">9</xref>]. In this study, we identified a novel variant, <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.4" ext-link-type="uri">NM_005861.4</ext-link>:c.352 C &gt; T, p.(Gln118*), in <italic>STUB1</italic> in compound heterozygosity in a Chinese female patient with SCAR16, and investigated the pathogenicity of this variant using functional studies. Herein, we also report the clinical characteristics of the patient, along with a 4-year follow-up.</p></sec><sec id="Sec2" disp-level="1"><title>Methods</title><sec id="Sec3" disp-level="2"><title>Participants</title><p id="Par22">The patient and her parents were enrolled in this study at the First Affiliated Hospital of Xiamen University. Ataxia severity was evaluated using the Scale for the Assessment and Rating of Ataxia (SARA) [<xref rid="CR10" ref-type="bibr">10</xref>] and the International Cooperative Ataxia Rating Scale (ICARS) [<xref rid="CR11" ref-type="bibr">11</xref>]. Participants were evaluated by at least two senior neurologists. The study also included 500 healthy southern Han Chinese controls from the Xiamen region. Written informed consent was obtained from all participants. Ethical approval was obtained from the Research Ethics Committee of the First Affiliated Hospital of Xiamen University.</p></sec><sec id="Sec4" disp-level="2"><title>Genetic testing</title><p id="Par23">Genomic DNA was extracted following standard procedures. SCA1, SCA2, SCA3, SCA6, SCA8, SCA12, SCA17, SCA36, and dentatorubral-pallidoluysian atrophy (DRPLA) repeat loci were amplified using long-range flanking polymerase chain reaction (PCR). The number of repeat units was estimated by agarose gel electrophoresis using a 3730xL Genetic Analyzer (XiangYin Biotechnology, Hangzhou, China). Whole-exome sequencing (WES) was performed and analyzed in patients as previously described [<xref rid="CR12" ref-type="bibr">12</xref>]. Briefly, an enriched DNA sample was sequenced using the HiSeq X Analyzer (Illumina, San Diego, CA). All variants were filtered and estimated using multiple databases, including the 1000 Genomes Project, Genome Aggregation, and ExAC databases. SIFT, CADD, and PolyPhen-2 were used to predict the effects of variants. The WES filtering criteria include: (1) the frequency of variants in the general population must be &lt; 1%, (2) synonymous variants are excluded, (3) variants disrupted gene function via frameshift or generation of a stop codon in the previously reported SCA causative genes are included, and (4) variants predicted to have functional impact by 3 software programs (SIFT, PolyPhen-2, and CADD) are included. The HGMD and ClinVar database were used to screen for mutations reported in published studies. The pathogenic variants were assessed using the American College of Medical Genetics and Genomics (ACMG) protocol [<xref rid="CR13" ref-type="bibr">13</xref>]. Potentially pathogenic variants were validated using conventional Sanger sequencing. Sequencing was performed for all available family members, as well as the 500 healthy controls, to validate the confirmed variants.</p></sec><sec id="Sec5" disp-level="2"><title>Plasmids, cell culture, and transfection</title><p id="Par24">The WT coding sequence of human <italic>STUB1</italic> (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.2" ext-link-type="uri">NM_005861.2</ext-link>) was cloned into the pCDH-CMV-MCS-EF1-copGFP vector. The 3×Flag tag was inserted onto the N-terminus of the WT coding sequence of human <italic>STUB1.</italic> All mutant constructs of <italic>STUB1</italic> c.352 C &gt; T p.(Gln118*), c.430 A &gt; T p.(Lys144*), and c.433 A &gt; C p.(Lys145Gln) were created using PCR mutagenesis and confirmed by Sanger sequencing. SH-SY5Y cells were maintained in Dulbecco’s modified Eagle’s medium (DMEM) (Gibco) supplemented with 10% fetal bovine serum (FBS) (Gibco) at 37 °C in 5% CO<sub>2</sub>. Cells were transiently transfected with WT plasmids, mutant plasmids (p.(Gln118*), p.(Lys144*) and p.(Lys145Gln)), or the empty vector (control) using Lipofectamine 3000 reagent (Invitrogen) according to the manufacturer’s protocol. Cells were harvested 48 h post-transfection for RNA level and protein level analysis. HEK293T cells were cultured in DMEM supplemented with 10% FBS and 1% penicillin/streptomycin at 37 °C under 5% CO₂. For transfection, cells were seeded in 6-well plates and transfected with plasmids encoding Flag-tagged WT plasmids, <italic>STUB1</italic> mutant plasmids (p.(Gln118*) and p.(Lys145Gln)), or empty vector (control) using polyethylenimine transfection reagents (Yeasen) according to the manufacturer’s protocol. HA-tagged ubiquitin (HA-Ub) was co-transfected to facilitate ubiquitination analysis. Cells were harvested 48 h post-transfection for immunoprecipitation.</p></sec><sec id="Sec6" disp-level="2"><title>Quantitative real-time PCR</title><p id="Par25">For RNA quantification, total RNA was extracted and reverse-transcribed into cDNA using the RevertAid First Strand cDNA Synthesis Kit (Invitrogen). Quantitative real-time PCR experiments were performed using SYBR Green qPCR Master Mix (Roche) following the manufacturer’s protocol. The following primer sequences were used: human <italic>STUB1</italic> (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.2" ext-link-type="uri">NM_005861.2</ext-link>, 5′-tacctctccaggctcattgc-3′, 5′-tcttgccacacaggtagtcg-3′) and human <italic>GAPDH</italic> (<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_002046.5" ext-link-type="uri">NM_002046.5</ext-link>, 5′-CAAGGTCATCCATGACAACTTTG-3′,5′-GTCCACCACCCTGTTGCTGTAG-3′). Detection and data analyses were performed using a real-time PCR detection system (CFX96; Bio-Rad).</p></sec><sec id="Sec7" disp-level="2"><title>Western blotting and <italic>In Vitro</italic> ubiquitination assay</title><p id="Par26">Western blotting was performed for <italic>STUB1</italic> protein level analysis. Protein samples were separated by 10% sodium dodecyl sulfate-polyacrylamide gel electrophoresis and transferred onto polyvinylidene fluoride membranes. The following primary antibodies were used: anti-STUB1 (Abcam) and anti-α-tubulin (Abcam). Three independent experiments were performed with technical and biological replicates. For the in vitro ubiquitination assay, HEK293T cells were co-transfected with plasmids encoding Flag-tagged STUB1 (WT or mutants), HA-tagged ubiquitin (HA-Ub), and Hsc70. At 48 h post-transfection, cells were lysed in IP buffer (20 mM Tris-HCl, pH 7.4, 100 mM NaCl, 1 mM EDTA, 0.5% NP-40) supplemented with protease inhibitor cocktail (Roche). Lysates were cleared by centrifugation at 12,000 × g for 10 min at 4 °C, and protein concentrations were determined using the BCA Protein Quantification Kit (Vazyme). Equal amounts of protein were incubated with anti-Hsc70 antibody (Santa Cruz Biotechnology) and Dynabeads Protein G (Thermo Fisher Scientific) overnight at 4 °C with gentle rotation. Immunoprecipitates were washed three times with lysis buffer and eluted by boiling in 1× SDS sample buffer. Samples were resolved by SDS-PAGE and transferred to PVDF membranes. Membranes were blocked with 5% non-fat milk in PBST (0.1% Tween-20) and probed with primary antibodies against Hsc70 (Santa Cruz Biotechnology), HA (Abmart), Flag (ABclonal), and β-actin (ABclonal), followed by HRP-conjugated secondary antibodies (Thermo Fisher Scientific). Protein bands were visualized using enhanced chemiluminescence and quantified using ImageJ software.</p></sec><sec id="Sec8" disp-level="2"><title>Statistical analysis</title><p id="Par27">All data are expressed as mean ± standard deviation. Statistical significance was analyzed by one-way analysis of variance using GraphPad Prism 9 software (GraphPad Software). <italic>P</italic>-values <italic>&lt;</italic> 0.05 were considered statistically significant.</p></sec></sec><sec id="Sec9" disp-level="1"><title>Results</title><sec id="Sec10" disp-level="2"><title>Clinical features</title><p id="Par28">The patient presented with feelings of instability and fear of falling when going down the stairs, which were among the early symptoms at onset at the age of 27 years (2018). She gradually developed poor distance discrimination while walking and climbing stairs. At the age of 29, she developed subtle gait imbalance, which was soon accompanied by mild dysarthria. The patient initially visited our hospital at the age of 30 years (2021). Clinical examination revealed cerebellar ataxia with abnormal finger-to-nose and heel-knee-shin test results, particularly on the left side. Her ICARS and SARA scores were 15/100 and 8/40, respectively. No cognitive impairment was observed. The cranial nerves, muscle strength, sensory examinations, and bilateral tendon reflexes were normal. She had no family history of neurological disease and gave birth to a boy at the age of 26 years. Laboratory examinations, including thyroid function tests, immunological marker examination, hormone levels, tumor marker examination, vitamin B12, and ceruloplasmin, were within the normal range, as were the results of the electrophysiological studies. Brain magnetic resonance imaging (MRI) revealed bilateral cerebellar atrophy (Fig. <xref rid="Fig1" ref-type="fig">1</xref>A). Based on the genetic results, we diagnosed the patient with SCAR16. The patient visited our hospital for follow-up visits once a year in the following three years. At the age of 31 years (2022), her physical examination showed mild jerks in the bilateral movement of the eyeballs, and tendon reflexes increased in the limbs. Her ICARS and SARA scores were 17/100 and 9/40. At the age of 32 years (2023), the patient complained of a slight decrease in flexibility when performing delicate work by hand, such as drawing pictures. Her ICARS and SARA scores were 20/100 and 9/40, respectively. At the age of 33 years (2024), compared to the previous year, she did not present any improvements in symptoms: her ICARS and SARA scores were 20/100 and 9/40, respectively. A summarized overview of the clinical symptoms of the patient (2021–2024) is presented in Table <xref rid="Tab1" ref-type="table">1</xref>.</p><fig id="Fig1" position="float"><?disp-level 3?><label>Fig. 1</label><caption><p>Brain MRI scans of the SCAR16 patient show bilateral cerebellar atrophy at the age of 30 years old. <bold>A</bold>, <bold>B</bold> Brain MRI (T1 series, axial) of patient, arrows for bilateral cerebellar atrophy. <bold>C</bold> Brain MRI (T1 series, midline sagittal) of patient, arrows for cerebellar atrophy</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e543" xlink:href="12883_2026_4815_Fig1_HTML.jpg"><?cloudpmc-path blobs/5984/13123184/14954d1c7cbf/12883_2026_4815_Fig1_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 743?><?original-width 1985?><?scaled-height 297?><?scaled-width 794?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="12883_2026_4815_Fig1_HTML.gif"><?cloudpmc-path blobs/5984/13123184/892e942ea72f/12883_2026_4815_Fig1_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><table-wrap id="Tab1" position="float"><?disp-level 3?><label>Table 1</label><caption><p>Summary of clinical features of the patient during 2021 to 2024</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" colspan="1" rowspan="1">Year</th><th align="left" colspan="1" rowspan="1">2021</th><th align="left" colspan="1" rowspan="1">2022</th><th align="left" colspan="1" rowspan="1">2023</th><th align="left" colspan="1" rowspan="1">2024</th></tr></thead><tbody><tr><td align="left" colspan="1" rowspan="1">Age (years)</td><td align="left" colspan="1" rowspan="1">30</td><td align="left" colspan="1" rowspan="1">31</td><td align="left" colspan="1" rowspan="1">32</td><td align="left" colspan="1" rowspan="1">33</td></tr><tr><td align="left" colspan="1" rowspan="1">Ataxia</td><td align="left" colspan="1" rowspan="1">+</td><td align="left" colspan="1" rowspan="1">+</td><td align="left" colspan="1" rowspan="1">+</td><td align="left" colspan="1" rowspan="1">+</td></tr><tr><td align="left" colspan="1" rowspan="1">Dysarthria</td><td align="left" colspan="1" rowspan="1">+</td><td align="left" colspan="1" rowspan="1">+</td><td align="left" colspan="1" rowspan="1">+</td><td align="left" colspan="1" rowspan="1">+</td></tr><tr><td align="left" colspan="1" rowspan="1">Spasticity</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Parkinsonism</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Epilepsy</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Hypogonadism</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Cognitive impairment</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Neuropsychology</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Sense of vibration</td><td align="left" colspan="1" rowspan="1">Normal</td><td align="left" colspan="1" rowspan="1">Normal</td><td align="left" colspan="1" rowspan="1">Normal</td><td align="left" colspan="1" rowspan="1">Normal</td></tr><tr><td align="left" colspan="1" rowspan="1">Muscle atrophy</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Babinski’s sign</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">-</td></tr><tr><td align="left" colspan="1" rowspan="1">Tendon reflexes</td><td align="left" colspan="1" rowspan="1">-</td><td align="left" colspan="1" rowspan="1">increased in UE and LE</td><td align="left" colspan="1" rowspan="1">increased in UE and LE</td><td align="left" colspan="1" rowspan="1">increased in UE and LE</td></tr><tr><td align="left" colspan="1" rowspan="1">ICARS</td><td align="left" colspan="1" rowspan="1">15</td><td align="left" colspan="1" rowspan="1">17</td><td align="left" colspan="1" rowspan="1">20</td><td align="left" colspan="1" rowspan="1">20</td></tr><tr><td align="left" colspan="1" rowspan="1">SARA</td><td align="left" colspan="1" rowspan="1">8</td><td align="left" colspan="1" rowspan="1">9</td><td align="left" colspan="1" rowspan="1">9</td><td align="left" colspan="1" rowspan="1">9</td></tr></tbody></table><table-wrap-foot><fn id="_fn_p20"><p>+ Positive, - Negative, <italic>UE</italic> Upper extremity, <italic>LE </italic>Lower extremity, <italic>ICARS </italic>International Cooperative Ataxia Rating Scale (0 to 100), <italic>SARA </italic>Scale for the Assessment and Rating of Ataxia (0 to 40)</p></fn></table-wrap-foot></table-wrap></sec><sec id="Sec12" disp-level="2"><title>Genetic findings</title><p id="Par31">Genetic testing for SCA1, SCA2, SCA3, SCA6, SCA7, SCA8, SCA12, SCA17, SCA36, and DRPLA showed negative results. WES was performed for the patient (<bold>II-1;</bold> Fig. <xref rid="Fig2" ref-type="fig">2</xref>A). The coverage of the fraction of target bases indicated that 95.01% of the target bases had &gt; 30x coverage. After filtering, the WES results revealed a compound heterozygote in <italic>STUB1</italic> bearing a novel nonsense variant, <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.4" ext-link-type="uri">NM_005861.4</ext-link>:c.352 C &gt; T, p.(Gln118*), and a missense variant, <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/nuccore/NM_005861.4" ext-link-type="uri">NM_005861.4</ext-link>:c.433 A &gt; C, p.(Lys145Gln). Both variants were confirmed using Sanger sequencing (Fig. <xref rid="Fig2" ref-type="fig">2</xref>B). Family co-segregation analysis showed that the patient’s father was heterozygous for the c.352 C &gt; T variant and her mother was heterozygous for the c.433 A &gt; C variant. The allele frequency of the <italic>STUB1</italic> c.352 C &gt; T variant was 0.0000062‌ in the Genome Aggregation database and absent from the 1000 Genomes Project and ExAC databases. This variant was not detected in the 500 healthy southern Han Chinese controls from the Xiamen region. Furthermore, the Gln118 residue was highly conserved across different vertebrate species (Fig. <xref rid="Fig2" ref-type="fig">2</xref>C). Another heterozygous missense variant, p.(Lys145Gln), has been demonstrated as a pathogenic mutation in several previous studies [<xref rid="CR14" ref-type="bibr">14</xref>, <xref rid="CR15" ref-type="bibr">15</xref>]. Generally, p.(Lys145Gln) was absent from controls and present at extremely low frequency in the databases (0.0006 in the Genome Aggregation database, 0.00059 in the 1000 Genomes Project, and 0.0007 in the ExAC databases), had positive co-segregation in reported families, and was predicted to be deleterious by computational analysis. Furthermore, functional studies have indicated that the p.(Lys145Gln) variant has a damaging effect on the CHIP gene product [<xref rid="CR8" ref-type="bibr">8</xref>, <xref rid="CR9" ref-type="bibr">9</xref>].</p><fig id="Fig2" position="float"><?disp-level 3?><label>Fig. 2</label><caption><p><italic>STUB1</italic> variants identified in a patient with spinocerebellar ataxia type 16 (SCAR16). <bold>A</bold> Pedigrees of the family with SCAR16 carrying the <italic>STUB1</italic> variants. Arrows indicate the proband of the family. <bold>B </bold>Sequencing chromatograms of the c.352 C &gt; T p.(Gln118*) and c.433 A &gt; C p.(Lys145Gln) variants within <italic>STUB1.</italic>
<bold>C</bold> Conservation analysis of the p.(Gln118*) and p.(Lys145Gln) variants in <italic>STUB1</italic> in different species shows conservation of the Gln118 and Lys145 residues throughout vertebrate species</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e818" xlink:href="12883_2026_4815_Fig2_HTML.jpg"><?cloudpmc-path blobs/5984/13123184/54284db3d21b/12883_2026_4815_Fig2_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1101?><?original-width 1985?><?scaled-height 440?><?scaled-width 794?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="12883_2026_4815_Fig2_HTML.gif"><?cloudpmc-path blobs/5984/13123184/29f40b8e8e18/12883_2026_4815_Fig2_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="Sec13" disp-level="2"><title>Functional analysis and classification of the novel variant</title><p id="Par33">We investigated the function of the p.(Gln118*) variant in <italic>STUB1</italic> through the in vitro experiments. We transfected <italic>STUB1</italic>-WT and <italic>STUB1</italic>-mutant plasmids into SY-5Y cell lines for RNA level and protein level analysis. The mRNA analysis indicated that the level of transcripts encoding the nonsense variant, p.(Gln118*), was almost the same as the level of the WT, whereas the levels of the p.(Lys145Gln) variant were increased; thus, they probably escaped nonsense-mediated decay (Fig. <xref rid="Fig3" ref-type="fig">3</xref>A). Furthermore, the protein levels of the WT and p.(Lys145Gln) variants were not significantly different; however, the p.(Gln118*) and p.(Lys144*) variants generated truncated proteins (Fig. <xref rid="Fig3" ref-type="fig">3</xref>B). Moreover, we included an in vitro ubiquitination assay to directly assess the E3 ligase activity of the <italic>STUB1</italic> p.(Gln118*) mutation. The results demonstrated that this truncation mutant exhibited significantly reduced ubiquitination activity toward Hsc70, with markedly decreased Hsc70 polyubiquitination compared to that of wild-type <italic>STUB1</italic> (Fig. <xref rid="Fig3" ref-type="fig">3</xref>C-E). This confirms that the premature termination mutation leads to the loss of E3 ubiquitin ligase function. These functional analyses favor an unstable protein product and then a loss-of-function effect. Thus, according to the ACMG standards, the c.352 C &gt; T, p.(Gln118*) variant of <italic>STUB1</italic> was classified as pathogenic, with one piece of very strong evidence, one piece of strong evidence, and two piece of moderate evidence. Specifically, a nonsense variant in a gene where loss of function is a known mechanism of disease is considered very strong evidence of pathogenicity. The in vitro functional studies indicating that the variant had a damaging effect on the gene product were considered strong evidence. The absence of the variant in the 500 controls and in the databases was considered moderate evidence. Furthermore, family co-segregation analysis was considered moderate evidence (Supplementary Table 1).</p><fig id="Fig3" position="float"><?disp-level 3?><label>Fig. 3</label><caption><p>Transfection studies of <italic>STUB1-</italic>wildtype (WT) and <italic>STUB1-</italic>mutant variants in cultured cells. <bold>A</bold> mRNA levels of STUB1 in the <italic>STUB1</italic>-WT and <italic>STUB1</italic>-mutant transfected cells, <italic>n</italic> = 3. <bold>B</bold> Western blot analysis of STUB1 protein expression. Anti-STUB1 antibodies were used as the primary antibodies (<italic>n</italic> = 3). <bold>C-E</bold> STUB1 mutation impair Hsc70 polyubiquitination. <bold>C</bold> Representative immunoblot analysis of polyubiquitinated Hsc70 in HEK293T cells. Cells were co-transfected with Flag-tagged STUB1 (WT or mutants: p.(Gln118*) and p.(Lys145Gln)), HA-tagged ubiquitin (HA-Ub), and Hsc70 expression plasmids, or empty vector (control). After 48 h, cells were lysed and Hsc70 was immunoprecipitated using anti-Hsc70 antibody. Ubiquitinated Hsc70 was detected by Western blot using anti-HA antibody. The high molecular weight smear indicates polyubiquitinated Hsc70. Total Hsc70 and STUB1 expression levels were assessed in input lysates using anti-Hsc70 and anti-Flag antibodies, respectively. <bold>D</bold> Quantification of total Hsc70 protein levels in input lysates from transfected cells (<italic>n</italic> = 6). <bold>E</bold> Quantification of polyubiquitinated Hsc70 levels normalized to total Hsc70 input (<italic>n</italic> = 6). Data are presented as mean ± SEM. P values were determined using one-way ANOVA followed by Tukey’s post hoc analysis. ns, not significant; *<italic>P</italic> &lt; 0.05; **<italic>P</italic> &lt; 0.01; ***<italic>P</italic> &lt; 0.001</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e914" xlink:href="12883_2026_4815_Fig3_HTML.jpg"><?cloudpmc-path blobs/5984/13123184/3984f0cd7b6f/12883_2026_4815_Fig3_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status LOAD_COMPLETED?><?original-height 1458?><?original-width 1985?><?scaled-height 583?><?scaled-width 794?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="12883_2026_4815_Fig3_HTML.gif"><?cloudpmc-path blobs/5984/13123184/e7562ce5aa00/12883_2026_4815_Fig3_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec></sec><sec id="Sec14" disp-level="1"><title>Discussion</title><p id="Par35">This study identified a compound heterozygote in <italic>STUB1</italic> containing a novel nonsense variant, c.352 C &gt; T, p.(Gln118*), and a pathogenic missense variant, c.433 A &gt; C, p.(Lys145Gln), in a Chinese SCAR16 family. CHIP, which is encoded by <italic>STUB1</italic>, mediates ubiquitination-mediated degradation by recruiting chaperones via the TPR domain and attaching E2-ubiquitin-conjugating enzymes via the U-box domain [<xref rid="CR16" ref-type="bibr">16</xref>]. The carrier of <italic>STUB1</italic> mutations existed the susceptibility of affecting SCAR16 and SCA48. However, the SCA48 displayed an autosomal dominant inheritance pattern which was different from the autosomal recessive inheritance pattern in our SCAR16 patient. The underlying pathogenic mechanisms are different between SCAR16 and SCA48. The previous study indicated that the biallelic mutations in SCAR16 resulted in a profound loss-of function of CHIP, leading to a systemic deficiency in protein quality control, while heterozygous <italic>STUB1</italic> variants in SCA48 acted through a possible dominant-interfering mechanism that corrupted the remaining wild-type function [<xref rid="CR17" ref-type="bibr">17</xref>]. The p.(Gln118*) variant is located in the TPR domain (residues 26–127), which is crucial for binding to heat shock proteins and functions as a co-chaperone. Currently, a total of 23 <italic>STUB1</italic> variants in the CHIP TPR domain have been reported in the HGMD. Interestingly, the p.(Ala52Gly) mutation, located between the first and second α-helical pairs in the TPR domain, reduces the affinity of CHIP for chaperones and decreases cellular fitness in response to certain cellular stressors, leading to SCA [<xref rid="CR18" ref-type="bibr">18</xref>]. Moreover, another study reported that p.(Asn65Ser) and p.(Leu123Val) mutations in the TPR domain caused SCAR16 by decreasing the ability of CHIP to bind chaperones [<xref rid="CR9" ref-type="bibr">9</xref>]. In the present study, functional studies in cultured cells indicated that <italic>STUB1</italic> p.(Gln118*) variant generated truncated proteins of the C-terminus of Hsc70-interacting protein and caused the loss function of ubiquitin ligase activity. Consequently, we classified the p.(Gln118*) variant in <italic>STUB1</italic> as pathogenic according to the ACMG standards. In our functional studies, both Gln118* and Lys144* variant proteins presented apparently larger molecular weights than expected. We considered that these larger-than-expected truncated proteins may be related to protein modification, such as glycosylation, which can lead to changes in protein size. In addition, compared to the Lys144* variant protein, the Gln118* variant protein had low expression levels and may be associated with greater protein instability despite a higher mRNA expression.</p><p id="Par36">Generally, SCAR16 presents as a multisystemic phenotype with cerebellar ataxia, cognitive decline, hypogonadism, pyramidal tract damage, and extrapyramidal symptoms. In our study, the SCAR16 patient presented with cerebellar ataxia, increased tendon reflex, and slow progression at the age of onset (27 years). However, the clinical manifestations and age at disease onset vary among patients who carried the mutations in the TPR domain in previous studies. A study reported that a Caucasian SCAR16 proband with mutation in the TPR domain p.(Leu123Val) developed cerebellar ataxia at the age of 2 years, which progressed slowly without cognitive impairment and spasticity [<xref rid="CR19" ref-type="bibr">19</xref>]. Another SCAR16 proband with a p.(Ala79Asp) mutation presented with cerebellar ataxia, increased tendon reflexes, and lower limb spasticity at the age of 29 years [<xref rid="CR20" ref-type="bibr">20</xref>]. Furthermore, a SCAR16 patient carrying mutations in the TPR domain p. (Ala120Val) exhibited cerebellar ataxia, cognitive impairment, and voice dystonia with age at onset of 21 years old [<xref rid="CR21" ref-type="bibr">21</xref>]. Additionally, another study indicated that the clinical characteristics of SCAR16 patients with the p.(Asn65Ser) mutation were cerebellar ataxia, tremor, dysarthria, and cognitive impairment [<xref rid="CR7" ref-type="bibr">7</xref>]. Although a previous study found that 94% of alleles with U-box mutations were associated with cognitive decline and that TPR mutations had no significant relationship with cognitive dysfunction [<xref rid="CR22" ref-type="bibr">22</xref>]. However, the relationship between the changes in CHIP biochemistry caused by <italic>STUB1</italic> mutations and disease phenotypes should be determined in further studies.</p></sec><sec id="Sec15" disp-level="1"><title>Conclusions</title><p id="Par37">This study identified a compound heterozygote in <italic>STUB1</italic> containing a novel nonsense variant, c.352 C &gt; T, p.(Gln118*), and a pathogenic missense variant, c.433 A &gt; C, p.(Lys145Gln), in a Chinese SCAR16 patient. We further confirmed the pathogenicity of the <italic>STUB1</italic> p.(Gln118*) variant, expanding the spectrum of causative variants associated with SCAR16.</p></sec><sec id="Sec16" disp-level="1"><title>Supplementary Information</title>
<supplementary-material id="MOESM1" position="float"><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="12883_2026_4815_MOESM1_ESM.docx" mimetype="application" mime-subtype="vnd.openxmlformats-officedocument.wordprocessingml.document"><?cloudpmc-path 5984/13123184/174c9f6699a2/12883_2026_4815_MOESM1_ESM.docx?><?cloudpmc-bucket app?><?size 13251?><caption><p>Supplementary Material 1.</p></caption></media></supplementary-material>

<supplementary-material id="MOESM2" position="float"><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="12883_2026_4815_MOESM2_ESM.rar" mimetype="application" mime-subtype="x-rar"><?cloudpmc-path 5984/13123184/52f0af71925d/12883_2026_4815_MOESM2_ESM.rar?><?cloudpmc-bucket app?><?size 1635670?><caption><p>Supplementary Material 2.</p></caption></media></supplementary-material>
</sec><sec id="ack1" sec-type="ack" disp-level="1"><title>Acknowledgements</title><p>The authors extend their sincere gratitude to all participants for their support and willingness to participate in this study.</p></sec><sec id="glossary1" sec-type="glossary" disp-level="1"><title>Abbreviations</title><def-list><def-item><term>ACMG</term><def><p id="Par5">American College of Medical Genetics and Genomics</p></def></def-item><def-item><term>CHIP</term><def><p id="Par6">C-terminus of Hsc70-interacting protein</p></def></def-item><def-item><term>DRPLA</term><def><p id="Par7">Dentatorubral-pallidoluysian atrophy</p></def></def-item><def-item><term>HGMD</term><def><p id="Par8">Human Gene Mutation Database</p></def></def-item><def-item><term>ICARS</term><def><p id="Par9">International Cooperative Ataxia Rating Scale</p></def></def-item><def-item><term>MRI</term><def><p id="Par10">Magnetic resonance imaging</p></def></def-item><def-item><term>PCR</term><def><p id="Par11">Polymerase chain reaction</p></def></def-item><def-item><term>SARA</term><def><p id="Par12">Scale for the Assessment and Rating of Ataxia</p></def></def-item><def-item><term>SCA</term><def><p id="Par13">Spinocerebellar ataxia</p></def></def-item><def-item><term>SCAR16</term><def><p id="Par14">Autosomal recessive spinocerebellar ataxia type 16</p></def></def-item><def-item><term>STUB1</term><def><p id="Par15">STIP1 homology and U-box containing protein 1</p></def></def-item><def-item><term>TPR</term><def><p id="Par16">Three-tetratricopeptide repeat</p></def></def-item><def-item><term>WES</term><def><p id="Par17">Whole-exome sequencing</p></def></def-item><def-item><term>WT</term><def><p id="Par18">Wild-type</p></def></def-item></def-list></sec><sec id="notes1" disp-level="1"><title>Authors' contributions</title><p>K-MZ, M-KT, and J-PL drafted and revised the manuscript.QL, MB, and H-JW contributed to cellular data acquisition and analysis. H-WJ, Z-WY, JW, and C-CX contributed to the clinical evaluation and specimen collection. J-XW, N-AX and BJ contributed to the design of the work and provided study supervision. All authors read and approved the final manuscript.</p></sec><sec id="notes2" disp-level="1"><title>Funding</title><p>This work was supported by grants from the Natural Science Foundation of Fujian Province to Bin Jiang (No. 2022J011359), the Natural Science Foundation of Fujian Province to Jing-Xun Wu (No. 2022J011380), the Medical and Health Guiding Project of Xiamen City to Bin Jiang (No. 3502Z20254ZD1047), and the Medical and Health Guiding Project of Xiamen City to Jing-Xun Wu (No. 3502Z20214ZD1011).</p></sec><sec id="notes3" disp-level="1"><title>Data availability</title><p>The datasets generated and/or analyzed during the current study are available in the NCBI repository upon publication (Accession number PRJNA1190204), https://www.ncbi.nlm.nih.gov/bioproject/PRJNA1190204.</p></sec><sec id="notes4" disp-level="1"><title>Declarations</title><sec id="FPar4" disp-level="2"><title>Ethics approval and consent to participate</title><p id="Par38">This study was conducted in accordance with the ethical principles outlined in the Declaration of Helsinki. Ethical approval was provided by the Research Ethics Committee of the First Affiliated Hospital of Xiamen University. Written informed consent was obtained from the participants themselves or their guardians.</p></sec><sec id="FPar5" disp-level="2"><title>Consent for publication</title><p id="Par39">Written informed consent for the publication was obtained from all participants.</p></sec><sec id="FPar6" disp-level="2"><title>Competing interests</title><p id="Par40">The authors declare no competing interests.</p></sec></sec><sec id="fn-group1" sec-type="fn-group" disp-level="1"><title>Footnotes</title><fn-group><fn id="fn1"><p><bold>Publisher’s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn id="fn2"><p>Kun-Mu 