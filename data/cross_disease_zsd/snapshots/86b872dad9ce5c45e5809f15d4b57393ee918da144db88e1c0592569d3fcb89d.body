ierName UI="Q000235" MajorTopicYN="N">genetics</QualifierName><QualifierName UI="Q000175" MajorTopicYN="N">diagnosis</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D008297" MajorTopicYN="N">Male</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D005260" MajorTopicYN="N">Female</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D005723" MajorTopicYN="N">gamma-Glutamyltransferase</DescriptorName><QualifierName UI="Q000097" MajorTopicYN="N">blood</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D005820" MajorTopicYN="N">Genetic Testing</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D009154" MajorTopicYN="N">Mutation</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D007223" MajorTopicYN="N">Infant</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D056726" MajorTopicYN="N">Genetic Association Studies</DescriptorName></MeshHeading></MeshHeadingList><KeywordList Owner="NOTNLM"><Keyword MajorTopicYN="N">gamma&#x2010;glutamyl transferase</Keyword><Keyword MajorTopicYN="N">genetic mutations</Keyword><Keyword MajorTopicYN="N">indirect bilirubinemia</Keyword><Keyword MajorTopicYN="N">neonatal cholestasis</Keyword></KeywordList></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="revised"><Year>2025</Year><Month>3</Month><Day>30</Day></PubMedPubDate><PubMedPubDate PubStatus="received"><Year>2025</Year><Month>1</Month><Day>3</Day></PubMedPubDate><PubMedPubDate PubStatus="accepted"><Year>2025</Year><Month>4</Month><Day>22</Day></PubMedPubDate><PubMedPubDate PubStatus="medline"><Year>2025</Year><Month>7</Month><Day>1</Day><Hour>21</Hour><Minute>15</Minute></PubMedPubDate><PubMedPubDate PubStatus="pubmed"><Year>2025</Year><Month>4</Month><Day>30</Day><Hour>6</Hour><Minute>26</Minute></PubMedPubDate><PubMedPubDate PubStatus="entrez"><Year>2025</Year><Month>4</Month><Day>30</Day><Hour>2</Hour><Minute>23</Minute></PubMedPubDate></History><PublicationStatus>ppublish</PublicationStatus><ArticleIdList><ArticleId IdType="pubmed">40302296</ArticleId><ArticleId IdType="doi">10.1111/jpc.70072</ArticleId></ArticleIdList><ReferenceList><Title>References</Title><Reference><Citation>R. Fawaz, U. Baumann, U. Ekong, et&#xa0;al., &#x201c;Guideline for the Evaluation of Cholestatic Jaundice in Infants: Joint Recommendations of the North American Society for Pediatric Gastroenterology, Hepatology, and Nutrition and the European Society for Pediatric Gastroenterology, Hepatology, and Nutrition,&#x201d; Journal of Pediatric Gastroenterology and Nutrition 64 (2017): 154&#x2013;168.</Citation></Reference><Reference><Citation>A. G. Feldman and R. J. Sokol, &#x201c;Neonatal Cholestasis,&#x201d; Journal of Neonatal&#x2010;Perinatal Medicine 14, no. 2 (2013): e63&#x2013;e73, https://doi.org/10.1542/neo.14&#x2010;2&#x2010;e63.</Citation></Reference><Reference><Citation>M. J. Monte, J. J. Marin, A. Antelo, and J. Vazquez&#x2010;Tato, &#x201c;Bile Acids: Chemistry, Physiology, and Pathophysiology,&#x201d; World Journal of Gastroenterology 15 (2009): 804.</Citation></Reference><Reference><Citation>W. F. Balistreri and J. A. Bezerra, &#x201c;Whatever Happened to &#x201c;Neonatal Hepatitis&#x201d;?,&#x201d; Clinics in Liver Disease 10 (2006): 27&#x2013;53.</Citation></Reference><Reference><Citation>M. Shagrani, J. Burkholder, D. Broering, et&#xa0;al., &#x201c;Genetic Profiling of Children With Advanced Cholestatic Liver Disease,&#x201d; Journal of Clinical Gastroenterology 92 (2017): 52&#x2013;61.</Citation></Reference><Reference><Citation>R. Jeyaraj, K. M. Bofrd, N. Ruth, et&#xa0;al., &#x201c;The Genetics of Inherited Cholestatic Disorders in Neonates and Infants: Evolving Challenges,&#x201d; Genetics in Medicine 12 (2021): 1837.</Citation></Reference><Reference><Citation>A. G. Feldman and R. J. Sokol, &#x201c;Recent Developments in Diagnostics and Treatment of Neonatal Cholestasis,&#x201d; in Seminars in Pediatric Surgery, vol. 29 (WB Saunders, 2020), 150945.</Citatio