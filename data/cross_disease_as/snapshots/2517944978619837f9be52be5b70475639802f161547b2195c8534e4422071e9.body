ticleIdList></Reference><Reference><Citation>Ann Surg. 2010 May;251(5):857-64</Citation><ArticleIdList><ArticleId IdType="pubmed">20101173</ArticleId></ArticleIdList></Reference><Reference><Citation>Trends Immunol. 2009 Aug;30(8):383-91</Citation><ArticleIdList><ArticleId IdType="pubmed">19643665</ArticleId></ArticleIdList></Reference><Reference><Citation>Curr Pharm Des. 2007;13(5):447-62</Citation><ArticleIdList><ArticleId IdType="pubmed">17348842</ArticleId></ArticleIdList></Reference><Reference><Citation>J Otolaryngol Head Neck Surg. 2009 Feb;38(1):133-41</Citation><ArticleIdList><ArticleId IdType="pubmed">19344623</ArticleId></ArticleIdList></Reference><Reference><Citation>J Biol Chem. 2001 Apr 27;276(17):13675-84</Citation><ArticleIdList><ArticleId IdType="pubmed">11278713</ArticleId></ArticleIdList></Reference><Reference><Citation>J Clin Oncol. 2004 Apr 15;22(8):1382-8</Citation><ArticleIdList><ArticleId IdType="pubmed">15007088</ArticleId></ArticleIdList></Reference><Reference><Citation>Ann Rheum Dis. 2010 Nov;69(11):1958-64</Citation><ArticleIdList><ArticleId IdType="pubmed">20511617</ArticleId></ArticleIdList></Reference><Reference><Citation>Eur Surg Res. 2007;39(1):1-6</Citation><ArticleIdList><ArticleId IdType="pubmed">17106199</ArticleId></ArticleIdList></Reference><Reference><Citation>Ann Surg. 2010 Nov;252(5):744-9</Citation><ArticleIdList><ArticleId IdType="pubmed">21037429</ArticleId></ArticleIdList></Reference><Reference><Citation>Arthritis Rheum. 2010 Feb;62(2):574-9</Citation><ArticleIdList><ArticleId IdType="pubmed">20112363</ArticleId></ArticleIdList></Reference><Reference><Citation>Biochem Pharmacol. 2010 Dec 15;80(12 ):2009-20</Citation><ArticleIdList><ArticleId IdType="pubmed">20599425</ArticleId></ArticleIdList></Reference><Reference><Citation>Nat Rev Clin Oncol. 2009 Jun;6(6):339-51</Citation><ArticleIdList><ArticleId IdType="pubmed">19399023</ArticleId></ArticleIdList></Reference><Reference><Citation>J Am Coll Surg. 2004 Feb;198(2):205-11</Citation><ArticleIdList><ArticleId IdType="pubmed">14759776</ArticleId></ArticleIdList></Reference></ReferenceList></PubmedData></PubmedArticle><PubmedArticle><MedlineCitation Status="PubMed-not-MEDLINE" Owner="NLM"><PMID Version="1">28350459</PMID><DateCompleted><Year>2018</Year><Month>06</Month><Day>13</Day></DateCompleted><DateRevised><Year>2018</Year><Month>06</Month><Day>13</Day></DateRevised><Article PubModel="Print-Electronic"><Journal><ISSN IssnType="Electronic">1523-7052</ISSN><JournalIssue CitedMedium="Internet"><Volume>19</Volume><Issue>7</Issue><PubDate><Year>2017</Year><Month>Apr</Month><Day>07</Day></PubDate></JournalIssue><Title>Organic letters</Title><ISOAbbreviation>Org Lett</ISOAbbreviation></Journal><ArticleTitle>STAT3 Inhibitory Activity of Structurally Simplified Withaferin A Analogues.</ArticleTitle><Pagination><StartPage>1538</StartPage><EndPage>1541</EndPage><MedlinePgn>1538-1541</MedlinePgn></Pagination><ELocationID EIdType="doi" ValidYN="Y">10.1021/acs.orglett.7b00332</ELocationID><Abstract><AbstractText>Signal transducer and activator of transcription 3 (STAT3) is a component of the JAK/STAT pathway. Therapeutic inhibition of STAT3 has been of high interest, as its aberrant activation has been linked to cancer, inflammation, and other human diseases. The withanolide family natural product withaferin A (1) inhibits STAT3 activation. We designed, synthesized, and evaluated simplified withanolide analogues SLW1 (3) and SLW2 (4), and found that SLW1 retained the STAT3 inhibitory activity of withaferin A.</AbstractText></Abstract><AuthorList CompleteYN="Y"><Author ValidYN="Y"><LastName>Tahara</LastName><ForeName>Teruyuki</ForeName><Initials>T</Initials><Identifier Source="ORCID">0000-0001-6608-8752</Identifier><AffiliationInfo><Affiliation>Department of Chemistry and Chemical Biology, Harvard University , 12 Oxford Street, Cambridge, Massachusetts 02138, United States.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Streit</LastName><ForeName>Ursula</ForeName><Initials>U</Initials><AffiliationInfo><Affiliation>Department of Chemistry and Chemical Biology, Harvard University , 12 Oxford Street, Cambridge, Massachusetts 02138, United States.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Pelish</LastName><ForeName>Henry E</ForeName><Initials>HE</Initials><AffiliationInfo><Affiliation>Department of Chemistry and Chemical Biology, Harvard University , 12 Oxford Street, Cambridge, Massachusetts 02138, United States.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Shair</LastName><ForeName>Matthew D</ForeName><Initials>MD</Initials><AffiliationInfo><Affiliation>Department of Chemistry and Chemical Biology, Harvard University , 12 Oxford Street, Cambridge, Massachusetts 02138, United States.</Affiliation></AffiliationInfo></Author></AuthorList><Language>eng</Language><PublicationTypeList><PublicationType UI="D016428">Journal Article</PublicationType><PublicationType UI="D013485">Research Support, Non-U.S. Gov't</PublicationType></PublicationTypeList><ArticleDate DateType="Electronic"><Year>2017</Year><Month>03</Month><Day>28</Day></ArticleDate></Article><MedlineJournalInfo><Country>United States</Country><MedlineTA>Org Lett</MedlineTA><NlmUniqueID>100890393</NlmUniqueID><ISSNLinking>1523-7052</ISSNLinking></MedlineJournalInfo></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="pubmed"><Year>2017</Year><Month>3</Month><Day>30</Day><Hour>6</Hour><Minute>0</Minute></PubMedPubDate><PubMedPubDate PubStatus="medline"><Year>2017</Year><Month>3</Month><Day>30</Day><Hour>6</Hour><Minute>1</Minute></PubMedPubDate><PubMedPubDate PubStatus="entrez"><Year>2017</Year><Month>3</Month><Day>29</Day><Hour>6</Hour><Minute>0</Minute></PubMedPubDate></History><PublicationStatus>ppublish</PublicationStatus><ArticleIdList><ArticleId IdType="pubmed">28350459</ArticleId><ArticleId IdType="doi">10.1021/acs.orglett.7b00332</ArticleId></ArticleIdList></PubmedData></PubmedArticle><PubmedArticle><MedlineCitation Status="PubMed-not-MEDLINE" Owner="NLM"><PMID Version="1">40746964</PMID><DateRevised><Year>2025</Year><Month>08</Month><Day>03</Day></DateRevised><Article PubModel="Print-Electronic"><Journal><ISSN IssnType="Print">1998-0124</ISSN><JournalIssue CitedMedium="Print"><Volume>17</Volume><Issue>10</Issue><PubDate><Year>2024</Year><Month>Oct</Month></PubDate></JournalIssue><Title>Nano research</Title><ISOAbbreviation>Nano Res</ISOAbbreviation></Journal><ArticleTitle>LPA<sub>1</sub> antagonist-derived LNPs deliver A20 mRNA and promote anti-fibrotic activities.</ArticleTitle><Pagination><StartPage>9095</StartPage><EndPage>9102</EndPage><MedlinePgn>9095-9102</MedlinePgn></Pagination><ELocationID EIdType="doi" ValidYN="Y">10.1007/s12274-024-6747-6</ELocationID><Abstract><AbstractText>Activated fibroblasts are major mediators of pulmonary fibrosis. Fibroblasts are generally found in the connective tissue but upon activation can generate excess extracellular matrix (ECM) in the lung interstitial section. Therefore, fibroblasts are one of the most targeted cells for treating idiopathic pulmonary fibrosis (IPF). Here, we develop an anti-fibrotic platform that can modulate both the lysophosphatidic acid receptor 1 (LPA<sub>1</sub>) and the inflammatory pathway through tumor necrosis factor <i>&#x3b1;</i>-induced protein 3 (TNFAIP3, also known as A20) in fibroblasts. First, we synthesized a series of LPA<sub>1</sub> antagonists, AM095 and AM966, derived amino lipids (LA lipids) which were formulated into LA-lipid nanoparticles (LA-LNPs) encapsulating mRNA. Specifically, LA5-LNPs, with AM966 head group and biodegradable acetal lipid tails, showed efficient A20 mRNA delivery to lung fibroblasts <i>in vitro</i> (80.2% &#xb1; 1.5%) and <i>ex vivo</i> (17.2% &#xb1; 0.4%). When treated to primary mouse lung fibroblasts (MLF), this formulation inhibited fibroblast migration and collagen production, thereby slowing the progression of IPF. Overall, LA5-LNPs encapsulated with A20 mRNA is a novel platform offering a potential approach to regulate fibroblast activation for the treatment of IPF.</AbstractText></Abstract><AuthorList CompleteYN="Y"><Author ValidYN="Y"><LastName>Yan</LastName><ForeName>Jingyue</ForeName><Initials>J</Initials><AffiliationInfo><Affiliation>Division of Pharmaceutics &amp; Pharmacology, College of Pharmacy, The Ohio State University, Columbus, OH 43210, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Kang</LastName><ForeName>Diana D</ForeName><Initials>DD</Initials><AffiliationInfo><Affiliation>Division of Pharmaceutics &amp; Pharmacology, College of Pharmacy, The Ohio State University, Columbus, OH 43210, USA.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Icahn Genomics Institute, Precision Immunology Institute, Department of Immunology and Immunotherapy, Department of Oncological Sciences, Tisch Cancer Institute, Biomedical Engineering and Imaging Institute, Friedman Brain Institute, Icahn School of Medicine at Mount Sinai, New York, NY 10029, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Wang</LastName><ForeName>Chang</ForeName><Initials>C</Initials><AffiliationInfo><Affiliation>Icahn Genomics Institute, Precision Immunology Institute, Department of Immunology and Immunotherapy, Department of Oncological Sciences, Tisch Cancer Institute, Biomedical Engineering and Imaging Institute, Friedman Brain Institute, Icahn School of Medicine at Mount Sinai, New York, NY 10029, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Hou</LastName><ForeName>Xucheng</ForeName><Initials>X</Initials><AffiliationInfo><Affiliation>Icahn Genomics Institute, Precision Immunology Institute, Department of Immunology and Immunotherapy, Department of Oncological Sciences, Tisch Cancer Institute, Biomedical Engineering and Imaging Institute, Friedman Brain Institute, Icahn School of Medicine at Mount Sinai, New York, NY 10029, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Du</LastName><ForeName>Shi</ForeName><Initials>S</Initials><AffiliationInfo><Affiliation>Division of Pharmaceutics &amp; Pharmacology, College of Pharmacy, The Ohio State University, Columbus, OH 43210, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Wang</LastName><ForeName>Siyu</ForeName><Initials>S</Initials><AffiliationInfo><Affiliation>Icahn Genomics Institute, Precision Immunology Institute, Department of Immunology and Immunotherapy, Department of Oncological Sciences, Tisch Cancer Institute, Biomedical Engineering and Imaging Institute, Friedman Brain Institute, Icahn School of Medicine at Mount Sinai, New York, NY 10029, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Xue</LastName><ForeName>Yonger</ForeName><Initials>Y</Initials><AffiliationInfo><Affiliation>Division of Pharmaceutics &amp; Pharmacology, College of Pharmacy, The Ohio State University, Columbus, OH 43210, USA.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Icahn Genomics Institute, Precision Immunology Institute, Department of Immunology and Immunotherapy, Department of Oncological Sciences, Tisch Cancer Institute, Biomedical Engineering and Imaging Institute, Friedman Brain Institute, Icahn School of Medicine at Mount Sinai, New York, NY 10029, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Liu</LastName><ForeName>Zhengwei</ForeName><Initials>Z</Initials><AffiliationInfo><Affiliation>Icahn Genomics Institute, Precision Immunology Institute, Department of Immunology and Immunotherapy, Department of Oncological Sciences, Tisch Cancer Institute, Biomedical Engineering and Imaging Institute, Friedman Brain Institute, Icahn School of Medicine at Mount Sinai, New York, NY 10029, USA.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Li</LastName><ForeName>Haoyuan</ForeName><Initials>H</Ini