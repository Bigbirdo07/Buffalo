so</LastName><ForeName>Mattia</ForeName><Initials>M</Initials><Identifier Source="ORCID">0000-0002-8521-4117</Identifier><AffiliationInfo><Affiliation>Department of Neurology, Brigham and Women's Hospital, Harvard Medical School, Boston, MA.</Affiliation></AffiliationInfo><AffiliationInfo><Affiliation>Department of Neurology, Medical University of South Carolina, Charleston.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Schimmel</LastName><ForeName>Mareike</ForeName><Initials>M</Initials><Identifier Source="ORCID">0000-0003-0076-4011</Identifier><AffiliationInfo><Affiliation>Division of Pediatric Neurology, Children's Hospital, Medical University of Augsburg, Germany.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Wendel</LastName><ForeName>Eva Maria</ForeName><Initials>EM</Initials><Identifier Source="ORCID">0000-0002-5242-1830</Identifier><AffiliationInfo><Affiliation>Department of Pediatric Neurology, Olgahospital/Klinikum Stuttgart, Germany.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Reindl</LastName><ForeName>Markus</ForeName><Initials>M</Initials><Identifier Source="ORCID">0000-0003-2817-1402</Identifier><AffiliationInfo><Affiliation>Clinical Department of Neurology, Medical University of Innsbruck, Austria; and.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Baumann</LastName><ForeName>Matthias</ForeName><Initials>M</Initials><Identifier Source="ORCID">0000-0003-4471-8324</Identifier><AffiliationInfo><Affiliation>Department of Pediatric and Adolescent Medicine, Medical University of Innsbruck, Austria.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Rostasy</LastName><ForeName>Kevin</ForeName><Initials>K</Initials><Identifier Source="ORCID">0000-0002-2180-5321</Identifier><AffiliationInfo><Affiliation>Department of Paediatric Neurology, Children's Hospital Datteln, University Witten and Herdecke, Datteln, Germany.</Affiliation></AffiliationIn