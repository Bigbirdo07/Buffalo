enter for Molecular Biology of the University of Heidelberg (ZMBH), DKFZ-ZMBH Alliance, Heidelberg, Germany.</Affiliation></AffiliationInfo></Author><Author ValidYN="Y"><LastName>Andr&#xe9;asson</LastName><ForeName>Claes</ForeName><Initials>C</Initials><Identifier Source="ORCID">0000-0001-8948-0685</Identifier><AffiliationInfo><Affiliation>Department of Molecular Biosciences, The Wenner-Gren Institute, Stockholm University, Stockholm, Sweden. claes.andreasson@su.se.</Affiliation></AffiliationInfo></Author></AuthorList><Language>eng</Language><DataBankList CompleteYN="Y"><DataBank><DataBankName>GEO</DataBankName><AccessionNumberList><AccessionNumber>GSE221651</AccessionNumber></AccessionNumberList></DataBank></DataBankList><GrantList CompleteYN="Y"><Grant><GrantID>2019-04052</GrantID><Agency>Vetenskapsr&#xe5;det (Swedish Research Council)</Agency><Country/></Grant><Grant><GrantID>20 1045</GrantID><Agency>Cancerfonden (Swedish Cancer Society)</Agency><Country/></Grant></GrantList><PublicationTypeList><PublicationType UI="D016428">Journal Article</PublicationType><PublicationType UI="D013485">Research Support, Non-U.S. Gov't</PublicationType></PublicationTypeList><ArticleDate DateType="Electronic"><Year>2024</Year><Month>02</Month><Day>15</Day></ArticleDate></Article><MedlineJournalInfo><Country>England</Country><MedlineTA>Nat Commun</MedlineTA><NlmUniqueID>101528555</NlmUniqueID><ISSNLinking>2041-1723</ISSNLinking></MedlineJournalInfo><ChemicalList><Chemical><RegistryNumber>0</RegistryNumber><NameOfSubstance UI="C469743">CHP1 protein, human</NameOfSubstance></Chemical><Chemical><RegistryNumber>0</RegistryNumber><NameOfSubstance UI="D002135">Calcium-Binding Proteins</NameOfSubstance></Chemical><Chemical><RegistryNumber>0</RegistryNumber><NameOfSubstance UI="D018832">Molecular Chaperones</NameOfSubstance></Chemical><Chemical><RegistryNumber>0</RegistryNumber><NameOfSubstance UI="C094814">EEF1A1 protein, human</NameOfSubstance></Chemical><Chemical><RegistryNumber>0</Regi