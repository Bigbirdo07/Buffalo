{"studies":[
{"protocolSection":{"identificationModule":{"nctId":"NCT00547469","orgStudyIdInfo":{"id":"DDP733-07-010"},"organization":{"fullName":"Dynogen Pharmaceuticals","class":"INDUSTRY"},"briefTitle":"A Study of the Safety and Effectiveness of DDP733 in Treating IBS With Constipation in Females","officialTitle":"A Randomized, Double-Blind, Placebo-Controlled Study to Evaluate the Safety and Effectiveness of DDP733 in Female Patients With Irritable Bowel Syndrome With Constipation"},"statusModule":{"statusVerifiedDate":"2008-04","overallStatus":"UNKNOWN","lastKnownStatus":"RECRUITING","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2007-10"},"studyFirstSubmitDate":"2007-10-19","studyFirstSubmitQcDate":"2007-10-19","studyFirstPostDateStruct":{"date":"2007-10-22","type":"ESTIMATED"},"lastUpdateSubmitDate":"2008-04-07","lastUpdatePostDateStruct":{"date":"2008-04-08","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Dynogen Pharmaceuticals","class":"INDUSTRY"}},"oversightModule":{"oversightHasDmc":true},"descriptionModule":{"briefSummary":"This study will evaluate the safety and effectiveness of the investigational drug DDP733 in treating female patients with IBS-c. A placebo control will be utilized."},"conditionsModule":{"conditions":["Irritable Bowel Syndrome"],"keywords":["Irritable Bowel Syndrome","IBS-c","IBS constipation","women with IBS","women with constipation"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2","PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"DOUBLE"}},"enrollmentInfo":{"count":360,"type":"ESTIMATED"}},"armsInterventionsModule":{"interventions":[{"type":"DRUG","name":"DDP733"}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Overall Subject Global Assessment (SGA) of relief of IBS symptoms, collected weekly"}],"secondaryOutcomes":[{"measure":"Weekly assessments of abdominal discomfort/pain, bowel habit, and satisfaction with bowel habit."},{"measure":"Other secondary efficacy variables reflecting IBS symptoms include daily assessments of abdominal discomfort/pain; abdominal bloating, the number and consistency of stools, straining at defecation, and feeling of incomplete evacuation."}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Female from 18 to 65 years of age, inclusive\n* Patient experiences recurrent abdominal pain or discomfort at least 3 days per month for the last 3 months with symptom onset at least 6 months prior to diagnosis. The patient's symptoms must be associated with 1 or more of the following:\n\n  * Improvement with defecation\n  * Onset associated with a change in frequency of stool\n  * Onset associated with a change in form (appearance) of stool\n* Negative serum and urine pregnancy tests\n* Completion of at least six days of daily diary assessments using a phone-in information system prior to randomization\n\nExclusion Criteria:\n\n* Serious underlying diseases, including psychiatric disorders\n* Current history of conditions affecting bowel transit\n* Recent history of biochemical or structural abnormalities of the gastrointestinal tract, gastrointestinal surgery, or gastrointestinal infection\n* Clinically significant abnormal examination findings or laboratory tests\n* Inability to stop taking certain medications, or a planned change in medications (including herbal remedies) which could interfere with study assessments\n* Use of drugs and or ethanol which may interfere with compliance of study procedures or influence study outcome\n* Presence of a medical condition which could interfere with the interpretation of study data\n* Significant use of nicotine or caffeine","healthyVolunteers":false,"sex":"FEMALE","minimumAge":"18 Years","maximumAge":"65 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"overallOfficials":[{"name":"Dynogen Study Director, MD","affiliation":"Dynogen Pharmaceuticals, Inc","role":"STUDY_DIRECTOR"}],"locations":[{"facility":"Alliance Clinical Trials","status":"RECRUITING","city":"Birmingham","state":"Alabama","zip":"35215","country":"United States","contacts":[{"name":"Jamie Carey","role":"CONTACT","phone":"205-815-5000","email":"jecarey88@bellsouth.net"},{"name":"James Sullivan, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":33.52066,"lon":-86.80249}},{"facility":"Clinical Research Associates","status":"RECRUITING","city":"Huntsville","state":"Alabama","zip":"35801","country":"United States","contacts":[{"name":"Christine Vanderkooy","role":"CONTACT","phone":"256-536-6605","email":"prochine@clinicalresearchassociates.biz"},{"name":"Allen C Goetsch, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":34.7304,"lon":-86.58594}},{"facility":"Medical Affiliated Research Center, Inc.","status":"RECRUITING","city":"Huntsville","state":"Alabama","zip":"35801","country":"United States","contacts":[{"name":"LuAnne Boggs","role":"CONTACT","phone":"256-533-6603","email":"jgm@marc-research.com"},{"name":"Suresh Karne, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":34.7304,"lon":-86.58594}},{"facility":"Mobile Medical Diagnostic","status":"RECRUITING","city":"Mobile","state":"Alabama","zip":"36617","country":"United States","contacts":[{"name":"Johnice Smith-Martin","role":"CONTACT","phone":"251-471-4402","email":"drrlbell@bellsouth.net"},{"name":"Raymond Bell, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":30.69436,"lon":-88.04305}},{"facility":"Pivotal Research Centers","status":"RECRUITING","city":"Peoria","state":"Arizona","zip":"85381","country":"United States","contacts":[{"name":"Susan Fadden","role":"CONTACT","phone":"623-815-9714","email":"sfadden@pivotalresearch.com"},{"name":"Louise Taber, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":33.5806,"lon":-112.23738}},{"facility":"Genova Clinical Research","status":"RECRUITING","city":"Tucson","state":"Arizona","zip":"85741","country":"United Stat