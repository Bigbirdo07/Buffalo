ption":"Participants received vatiquinone capsule at a dose of either 200 mg orally TID if ˂12 years of age and weighing ˂25 kg or 400 mg orally TID if ≥12 years of age and/or weighing ≥25 kg for 72 weeks during the double-blind phase.","deathsNumAffected":1,"deathsNumAtRisk":73,"seriousNumAffected":8,"seriousNumAtRisk":73,"otherNumAffected":71,"otherNumAtRisk":73},{"id":"EG001","title":"Double-blind Phase: Placebo","description":"Participants received placebo matching to vatiquinone (per age and weight) orally TID for 72 weeks during the double-blind phase.","deathsNumAffected":1,"deathsNumAtRisk":73,"seriousNumAffected":8,"seriousNumAtRisk":73,"otherNumAffected":73,"otherNumAtRisk":73},{"id":"EG002","title":"On-Vatiquinone Period: Vatiquinone/Vatiquinone","description":"Participants who received vatiquinone for 72 weeks in the double-blind phase continued to receive vatiquinone capsule at a dose of either 200 mg orally TID if ˂12 years of age and weighing ˂25 kg or 400 mg orally TID if ≥12 years of age and/or weighing ≥25 kg for 24 weeks during the open-label phase.","deathsNumAffected":1,"deathsNumAtRisk":73,"seriousNumAffected":10,"seriousNumAtRisk":73,"otherNumAffected":71,"otherNumAtRisk":73},{"id":"EG003","title":"On-Vatiquinone Period: Placebo/Vatiquinone","description":"Participants who received placebo for 72 weeks in the double-blind phase, received vatiquinone at a dose of either 200 mg orally TID if ˂12 years of age and weighing ˂25 kg or 400 mg orally TID if ≥12 years of age and/or weighing ≥25 kg for 24 weeks during the open-label phase.","deathsNumAffected":0,"deathsNumAtRisk":65,"seriousNumAffected":2,"seriousNumAtRisk":65,"otherNumAffected":53,"otherNumAtRisk":65}],"seriousEvents":[{"term":"Myocarditis","organSystem":"Cardiac disorders","sourceVocabulary":"MedDRA 26.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":1,"numAffected":1,"numAtRisk":73},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":73},{"