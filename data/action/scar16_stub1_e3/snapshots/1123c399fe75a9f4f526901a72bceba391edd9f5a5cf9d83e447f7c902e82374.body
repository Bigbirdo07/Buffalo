OG000","OG002"],"groupDescription":"Change at Week 12, Gait","nonInferiorityType":"SUPERIORITY","paramType":"Least Squares Mean Difference","paramValue":"0.3","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.0","ciUpperLimit":"0.5","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.14"}]},{"type":"SECONDARY","title":"Change From Baseline in the Timed 25-Foot Walk (T25FW)","description":"The participant was instructed to walk 25 feet as quickly as possible, but safely. The time was calculated from the initiation of the instruction to start and ends when the participant has reached the 25-foot mark. The task was immediately administered again by having the participant walk back the same distance. The two trials were averaged. A negative change from Baseline indicates improvement. Change from Baseline in T25FW was analyzed using MMRM ANCOVA with Baseline T25FW as a covariate; pooled site, visit, treatment, and ambulation status (randomization factor) as fixed factors; and treatment-by-visit and Baseline T25FW-by-visit interactions.","populationDescription":"FAS included all randomized participant who received at least 1 dose of the study drug for the treatment period. Number analyzed is the number of participants with data available for analysis at the given time-point.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"seconds","timeFrame":"Baseline and Weeks 2, 7 and 12","groups":[{"id":"OG000","title":"Placebo","description":"TAK-831 placebo-matching tablets, orally, twice daily for up to 12 weeks."},{"id":"OG001","title":"TAK-831 75 mg","description":"TAK-831 75 mg, tablets, orally, twice daily for up to 12 weeks."},{"id":"OG002","title":"TAK-831 300 mg","description":"TAK-831 300 mg, tablets, orally, twice daily for up to 12 weeks."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"27"},{"groupId":"OG001","value":"14"},{"groupId":"OG002","value":"26"}]}],"classes":[{"title":"Change from Baseline at Week 2","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"11"},{"groupId":"OG001","value":"6"},{"groupId":"OG002","value":"12"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0.61","spread":"0.901"},{"groupId":"OG001","value":"0.84","spread":"1.124"},{"groupId":"OG002","value":"1.95","spread":"0.990"}]}]},{"title":"Change from Baseline at Week 7","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"11"},{"groupId":"OG001","value":"6"},{"groupId":"OG002","value":"11"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"1.67","spread":"0.948"},{"groupId":"OG001","value":"1.77","spread":"1.255"},{"groupId":"OG002","value":"1.37","spread":"1.080"}]}]},{"title":"Change from Baseline at Week 12","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"11"},{"groupId":"OG001","value":"5"},{"groupId":"OG002","value":"10"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0.52","spread":"0.903"},{"groupId":"OG001","value":"2.70","spread":"1.226"},{"groupId":"OG002","value":"1.30","spread":"1.057"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Change from Baseline at Week 2","nonInferiorityType":"SUPERIORITY","pValue":"0.599","pValueComment":"P-values are 1-sided, with the alternative hypothesis that TAK-831 is superior to placebo in the clinically favorable direction.","statisticalMethod":"ANCOVA","paramType":"Least Squares Mean Difference","paramValue":"0.23","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"-1.31","ciUpperLimit":"1.76","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.889"},{"groupIds":["OG000","OG002"],"groupDescription":"Change from Baseline at Week 2","nonInferiorityType":"SUPERIORITY","pValue":"0.978","pValueComment":"P-values are 1-sided, with the alternative hypothesis that TAK-831 is superior to placebo in the clinically favorable direction.","statisticalMethod":"ANCOVA","paramType":"Least Squares Mean Difference","paramValue":"1.34","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.26","ciUpperLimit":"2.42","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.625"},{"groupIds":["OG000","OG001"],"groupDescription":"Change from Baseline at Week 7","nonInferiorityType":"SUPERIORITY","pValue":"0.533","pValueComment":"P-values are 1-sided, with the alternative hypothesis that TAK-831 is superior to placebo in the clinically favorable direction.","statisticalMethod":"ANCOVA","paramType":"Least Squares Mean Difference","paramValue":"0.09","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"-1.87","ciUpperLimit":"2.06","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"1.140"},{"groupIds":["OG000","OG002"],"groupDescription":"Change from Baseline at Week 7","nonInferiorityType":"SUPERIORITY","pValue":"0.370","pValueComment":"P-values are 1-sided, with the alternative hypothesis that TAK-831 is superior to placebo in the clinically favorable direction.","statisticalMethod":"ANCOVA","paramType":"Least Squares Mean Difference","paramValue":"-0.30","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"-1.83","ciUpperLimit":"1.23","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.886"},{"groupIds":["OG000","OG001"],"groupDescription":"Change from Baseline at Week 12","nonInferiorityType":"SUPERIORITY","pValue":"0.972","pValueComment":"P-values are 1-sided, with the alternative hypothesis that TAK-831 is superior to placebo in the clinically favorable direction.","statisticalMethod":"ANCOVA","paramType":"Least Squares Mean Difference","paramValue":"2.18","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.32","ciUpperLimit":"4.04","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"1.078"},{"groupIds":["OG000","OG002"],"groupDescription":"Change from Baseline at Week 12","nonInferiorityType":"SUPERIORITY","pValue":"0.825","pValueComment":"P-values are 1-sided, with the alternative hypothesis that TAK-831 is superior to placebo in the clinically favorable direction.","statisticalMethod":"ANCOVA","paramType":"Least Squares Mean Difference","paramValue":"0.78","ciPctValue":"90","ciNumSides":"TWO_SIDED","ciLowerLimit":"-0.63","ciUpperLimit":"2.19","dispersionType":"STANDARD_ERROR_OF_MEAN","dispersionValue":"0.819"}]},{"type":"SECONDARY","title":"Change From Baseline in the 9-HPT and T25FW Composite Score","description":"9-HPT and T25FW were evaluated together as a performance-based composite measure. The inverse transform of each score was computed. The inverse scores from each test were tabulated and converted to test-specific Z scores by subtracting the cohort mean from the raw score, and then dividing by the cohort standard deviation (SD) to create a Z score for the test. The composite Z scores were created by subtracting Z-score for T25FW from the Z-score for 9-HPT-1. A larger Z-score represents a better outcome. A positive change from Baseline indicates improvement. Change from Baseline in composite score was analyzed using MMRM ANCOVA with Baseline composite score as a covariate; pooled site, visit, treatment, and ambulation status (randomization factor) as fixed factors; and treatment-by-visit and Baseline composite score-by-visit interactions.","populationDescription":"FAS included all randomized participant who received at least 1 dose of the study drug for the treatment period. Number analyzed is the number of participants with data available for analysis at the given time-point.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"z-score","timeFrame":"Baseline and Weeks 2, 7, and 12","groups":[{"id":"OG000","title":"Placebo","description":"TAK-831 placebo-matching tablets, orally, twice daily for up to 12 weeks."},{"id":"OG001","title":"TAK-831 75 mg","description":"TAK-831 75 mg, tablets, orally, twice daily for up to 12 weeks."},{"id":"OG002","title":"TAK-831 300 mg",