ww.ebi.ac.uk/chembl/compound_report_card/CHEMBL1201498"}],"id":"http://europepmc.org/article/MED/25405820#opentargets-f8c647d6c524be73e179a745b8c6a465","type":"Disease Drug Relationship","section":"Abstract (http://purl.org/dc/terms/abstract)","provider":"Open Targets Platform"},{"exact":"These associations include ERAP1, CCR1-CCR3, STAT4, KLRC4, GIMAP4, and TNFAIP3 in Behçet's disease; BLK and CD40 in Kawasaki disease; SERPINA1 and SEMA6A in antineutrophil cytoplasmic antibody associated vasculitides; IL12B and FCGR2A/ FCGR2A in Takayasu arteritis; and CECR1 in a newly defined vascular inflammatory syndrome associated with adenosine deaminase (ADA2) deficiency.","tags":[{"name":"CD40","uri":"https://www.ensembl.org/Homo_sapiens/Gene/Summary?db=core;g=ENSG00000101017"},{"name":"Kawasaki disease","uri":"https://www.ebi.ac.uk/ols/ontologies/efo/terms?short_form=EFO_0004246"}],"id":"http://europepmc.org/article/MED/25405820#opentargets-8431dccc0b236deead7a458fa23402e1","type":"Gene Disease Relationship","section":"Abstract (http://purl.org/dc/terms/abstract)","provider":"Open Targets Platform"},{"exact":"These associations include ERAP1, CCR1-CCR3, STAT4, KLRC4, GIMAP4, and TNFAIP3 in Behçet's disease; BLK and CD40 in Kawasaki disease; SERPINA1 and SEMA6A in antineutrophil cytoplasmic antibody associated vasculitides; IL12B and FCGR2A/ FCGR2A in Takayasu arteritis; and CECR1 in a newly defined vascular inflammatory syndrome associated with adenosine deaminase (ADA2) deficiency.","tags":[{"name":"IL12B","uri":"https://www.ensembl.org/Homo_sapiens/Gene/Summary?db=core;g=ENSG00000113302"},{"name":"Takayasu arteritis","uri":"https://www.ebi.ac.uk/ols/ontologies/efo/terms?short_form=EFO_1001857"}],"id":"http://europepmc.org/article/MED/25405820#opentargets-b41974e15648b954b9b9a89ad20d167d","type":"Gene Disease Relationship","section":"Abstract (http://purl.org/dc/terms/abstract)","provider":"Open Targets Platform"},{"exact":"These associations include ERAP1, CCR1-CCR3, ST