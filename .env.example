APP_ENV=development
DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
MONARCH_API_BASE=https://api.monarchinitiative.org/v3/api

# --- Mechanism critic (Phase 5G) -------------------------------------------
# The critic is ADVISORY. It never overwrites deterministic synthesis, and the
# pipeline runs to completion with no key set: every LLM-derived statement is
# stored as derived, with model, prompt version and input evidence ids.
#
# Set exactly one provider. ATLAS_CRITIC_PROVIDER selects it.
#
# IMPORTANT: keep these in this file, not in your shell profile. A globally
# exported ANTHROPIC_API_KEY can cause Claude Code to bill your API balance
# instead of your subscription.
ATLAS_CRITIC_PROVIDER=none
# none | anthropic | openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# The challenge brief asks specifically for OpenAI; prefer this when available.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
